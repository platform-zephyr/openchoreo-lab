{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(python3 tools/appgen/*)",
      "Bash(python3 tools/backlog/*)",
      "Bash(bash tests/*)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)"
    ],
    "deny": [
      "Bash(kubectl *)",
      "Bash(helm *)",
      "Bash(oc *)",
      "Bash(occ *)",
      "Bash(argocd *)",
      "Bash(tofu *)",
      "Bash(terraform *)",
      "Bash(doppler *)",
      "Bash(oci *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "Bash(env)",
      "Bash(printenv*)",
      "Bash(* | sh)",
      "Bash(* | sh *)",
      "Bash(* | bash)",
      "Bash(* | bash *)",
      "Bash(sh -s*)",
      "Bash(bash -s*)",
      "Bash(git push *--force*)",
      "Bash(git push * -f)",
      "Bash(git push -f*)",
      "Bash(git push * main)",
      "Bash(git push *:main)",
      "Bash(git commit *--no-verify*)",
      "Bash(git push *--no-verify*)",
      "Bash(gh pr merge *--admin*)",
      "Bash(gh api *DELETE*)",
      "Bash(gh secret *)",
      "Bash(gh auth token*)",
      "Bash(gh repo delete *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/kubeconfig*)",
      "Read(~/.ssh/**)",
      "Read(~/.kube/**)",
      "Read(~/.aws/**)",
      "Read(~/.oci/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/doppler/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.claude/.credentials.json)",
      "Edit(/generated/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": false,
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.kube",
        "~/.aws",
        "~/.oci",
        "~/.config/gh",
        "~/.config/doppler",
        "~/.docker/config.json"
      ]
    }
  },
  "bashOutputMaxChars": 20000
}
