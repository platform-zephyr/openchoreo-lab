{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "identity-inventory.v1",
  "title": "Inventaire des identités et matrice identité × catégories de secrets (T-183)",
  "description": "Noms, types, surfaces, durées, propriétaires, échéances, catégories accessibles et chemins d'élévation. AUCUN champ de valeur (additionalProperties=false partout). Les credentials sont référencés par leur NOM dans docs/state/identities.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "categories", "identities"],
  "properties": {
    "version": {"const": 1},
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/category"}
    },
    "identities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/identity"}
    }
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "date": {"type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"},
    "text": {"type": "string", "minLength": 2, "maxLength": 160},
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "short", "description"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "short": {"type": "string", "pattern": "^[A-Za-z0-9-]{2,12}$"},
        "description": {"$ref": "#/$defs/text"}
      }
    },
    "access": {"enum": ["presence", "creation", "ecriture", "valeur", "valeur-break-glass"]},
    "elevation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["to", "via", "class"],
      "properties": {
        "to": {"$ref": "#/$defs/slug"},
        "via": {"$ref": "#/$defs/text"},
        "class": {"enum": ["REVUE", "MANDAT"]}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "status", "authentication", "surface", "token_ttl", "owner", "expires",
                   "secrets", "credentials", "elevation"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "type": {"enum": ["humain", "agent", "ci", "eso", "crossplane", "plateforme", "iac", "job"]},
        "status": {"enum": ["actif", "propose"]},
        "authentication": {"$ref": "#/$defs/text"},
        "surface": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "token_ttl": {"type": "string", "pattern": "^([1-9][0-9]*(m|h|d)|n/a)$"},
        "owner": {"enum": ["paul", "plateforme"]},
        "expires": {"$ref": "#/$defs/date"},
        "secrets": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/slug"},
          "additionalProperties": {"$ref": "#/$defs/access"}
        },
        "credentials": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
        "dev_deviations": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
        "registry_consumers": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
        "elevation": {"type": "array", "items": {"$ref": "#/$defs/elevation"}},
        "note": {"type": "string", "maxLength": 200}
      }
    }
  }
}
