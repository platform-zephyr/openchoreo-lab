{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/platform-zephyr/openchoreo-lab/docs/schema/app.schema.json",
  "title": "platform.smadja.dev/v2alpha1 App",
  "description": "Contrat applicatif du labo OpenChoreo : apps/<name>/app.yaml (+ values.yaml pour le parcours helm). Derive de kube-ops platform.smadja.dev/v1 Application (k8s/charts/platform-app/values.schema.json@ef50472). Jamais de valeur secrete. Extensions E1-E3, E6-E9, E12 et parcours Helm : toutes optionnelles, aucune rupture avec les apps v2alpha1 existantes (docs/APP-CONTRACT.md section 1.1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "definitions": {
    "image": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/-]*(:[A-Za-z0-9._-]+)?@sha256:[a-f0-9]{64}$"
    },
    "subName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,10}[a-z0-9]$",
      "description": "Nom court d'un workload, d'un job ou d'un volume. Composant OpenChoreo = <app>-<nom>. 'main' designe le runtime principal."
    },
    "envName": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
    "env": {
      "type": "object", "maxProperties": 32,
      "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
      "additionalProperties": { "type": "string", "maxLength": 1024 },
      "description": "Variables NON secretes."
    },
    "ports": {
      "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1, "maximum": 65535 },
      "description": "Ports TCP de destination. Obligatoires : pas de regle 'tous ports'."
    },
    "egressRule": {
      "type": "object",
      "oneOf": [
        {
          "additionalProperties": false, "required": ["fqdn", "ports"],
          "properties": {
            "fqdn": { "type": "string", "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z][a-z0-9-]{0,61}[a-z0-9]$", "maxLength": 253 },
            "ports": { "$ref": "#/definitions/ports" }
          }
        },
        {
          "additionalProperties": false, "required": ["fqdnPattern", "ports"],
          "properties": {
            "fqdnPattern": { "type": "string", "pattern": "^\\*\\.([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z][a-z0-9-]{0,61}[a-z0-9]$", "maxLength": 253 },
            "ports": { "$ref": "#/definitions/ports" }
          }
        },
        {
          "additionalProperties": false, "required": ["cidr", "ports"],
          "properties": {
            "cidr": { "type": "string", "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}$" },
            "ports": { "$ref": "#/definitions/ports" }
          }
        },
        {
          "additionalProperties": false, "required": ["app"],
          "properties": {
            "app": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,18}[a-z0-9]$", "description": "Autre app native du depot (Project OpenChoreo)." },
            "workload": { "$ref": "#/definitions/subName", "description": "Workload cible ; defaut : main." },
            "envVar": { "$ref": "#/definitions/envName", "description": "Variable recevant l'adresse resolue ; defaut <APP>_URL." }
          }
        }
      ]
    },
    "volume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "profile", "mountPath", "size"],
      "properties": {
        "name": { "$ref": "#/definitions/subName" },
        "profile": { "enum": ["block-rwo", "rwx-shared"], "description": "StorageClass resolue par clusters/<cluster>/capabilities.yaml ; profil absent du cluster = refus." },
        "mountPath": { "type": "string", "pattern": "^/[A-Za-z0-9._/-]+$" },
        "size": { "type": "string", "pattern": "^[1-9][0-9]{0,3}Gi$" },
        "workload": { "$ref": "#/definitions/subName", "description": "Workload qui monte le volume ; defaut : main. Les jobs ne montent pas de volume." },
        "readOnly": { "type": "boolean", "default": false }
      }
    },
    "extraRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size"],
      "properties": {
        "port": { "type": "integer", "minimum": 1024, "maximum": 65535, "description": "Absent = worker sans endpoint. Visibilite : projet seulement (jamais exposee)." },
        "protocol": { "enum": ["HTTP", "TCP"], "default": "HTTP" },
        "healthPath": { "type": "string", "pattern": "^/[A-Za-z0-9._/-]*$", "maxLength": 128 },
        "size": { "enum": ["small", "medium"] },
        "replicas": { "type": "integer", "minimum": 1, "maximum": 3, "default": 1 },
        "runAsUser": { "type": "integer", "minimum": 1000, "default": 65532 },
        "command": { "type": "array", "items": { "type": "string" }, "maxItems": 16 },
        "args": { "type": "array", "items": { "type": "string" }, "maxItems": 32 },
        "env": { "$ref": "#/definitions/env" }
      }
    },
    "consumers": {
      "database": { "type": "boolean", "default": false, "description": "Lie la base de spec.database a ce workload." },
      "secrets": { "type": "array", "uniqueItems": true, "maxItems": 16, "items": { "$ref": "#/definitions/envName" }, "description": "Sous-ensemble de spec.secrets[].env injecte dans ce workload." }
    }
  },
  "properties": {
    "apiVersion": { "const": "platform.smadja.dev/v2alpha1" },
    "kind": { "const": "App" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "owner", "description"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,18}[a-z0-9]$",
          "description": "= repertoire, Project et Component OpenChoreo, base et role CNPG (tirets -> _)."
        },
        "owner": { "type": "string", "pattern": "^(group|user):default/[a-z][a-z0-9-]*$" },
        "description": { "type": "string", "minLength": 1, "maxLength": 200 },
        "docs": { "type": "string", "format": "uri" },
        "lifecycle": { "enum": ["experimental", "production", "deprecated"], "default": "experimental" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "cluster", "environments", "profile", "exposure", "network", "backup", "observability"],
      "properties": {
        "delivery": {
          "enum": ["native", "helm"],
          "description": "Optionnel, calcule (APP-CONTRACT.md section 3). S'il est ecrit et differe du calcul : CI rouge."
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "oneOf": [{ "required": ["image"] }, { "required": ["chart"] }],
          "properties": {
            "image": { "$ref": "#/definitions/image" },
            "chart": {
              "type": "object",
              "additionalProperties": false,
              "required": ["repo", "name", "version", "digest"],
              "properties": {
                "repo": { "type": "string", "pattern": "^(oci|https)://" },
                "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
                "version": { "type": "string", "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$", "description": "Version exacte : ni plage, ni latest." },
                "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$", "description": "Obligatoire (chart epingle) ; verifie en CI par helm pull + sha256." }
              }
            }
          }
        },
        "cluster": {
          "enum": ["k3d", "oke"],
          "description": "k3d = Phase 0 (Mac arm64). oke = seulement apres le gate OKE. Politique : clusters/<cluster>/capabilities.yaml."
        },
        "environments": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["development", "production"] }
        },
        "profile": { "enum": ["stateless", "stateful"] },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["port", "healthPath", "size"],
          "description": "Workload principal (main). Parcours native uniquement.",
          "properties": {
            "port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
            "healthPath": { "type": "string", "pattern": "^/[A-Za-z0-9._/-]*$", "maxLength": 128 },
            "healthProbe": { "type": "boolean", "default": true, "description": "false = aucune probe readiness/liveness rendue (healthPath non prouve en amont). Defaut true (T-010)." },
            "size": { "enum": ["small", "medium"], "description": "small=50m/128Mi req, 250m/256Mi lim ; medium=200m/256Mi req, 500m/512Mi lim (table kube-ops)." },
            "replicas": { "type": "integer", "minimum": 1, "maximum": 3, "default": 1 },
            "runAsUser": { "type": "integer", "minimum": 1000, "default": 65532 },
            "command": { "type": "array", "items": { "type": "string" }, "maxItems": 16 },
            "args": { "type": "array", "items": { "type": "string" }, "maxItems": 32 },
            "env": { "$ref": "#/definitions/env" }
          }
        },
        "workloads": {
          "type": "array", "maxItems": 4,
          "description": "E6. Workloads supplementaires du meme Project (meme cellule). Un conteneur chacun : pas de sidecar (Workload.spec.container est unique en v1.3.3).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "kind", "runtime"],
            "properties": {
              "name": { "$ref": "#/definitions/subName" },
              "kind": { "enum": ["Deployment", "StatefulSet"] },
              "image": { "$ref": "#/definitions/image", "description": "Defaut : spec.source.image." },
              "runtime": { "$ref": "#/definitions/extraRuntime" },
              "database": { "$ref": "#/definitions/consumers/database" },
              "secrets": { "$ref": "#/definitions/consumers/secrets" }
            }
          }
        },
        "jobs": {
          "type": "array", "maxItems": 4,
          "description": "E7. CronJobs du Project. concurrencyPolicy Forbid impose.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "schedule", "runtime"],
            "properties": {
              "name": { "$ref": "#/definitions/subName" },
              "schedule": { "type": "string", "pattern": "^([0-9*/,-]+ ){4}[0-9A-Za-z*/,-]+$" },
              "timeZone": { "type": "string", "pattern": "^[A-Za-z_]+(/[A-Za-z_]+)*$" },
              "image": { "$ref": "#/definitions/image" },
              "runtime": {
                "type": "object",
                "additionalProperties": false,
                "required": ["size"],
                "properties": {
                  "size": { "enum": ["small", "medium"] },
                  "runAsUser": { "type": "integer", "minimum": 1000, "default": 65532 },
                  "command": { "type": "array", "items": { "type": "string" }, "maxItems": 16 },
                  "args": { "type": "array", "items": { "type": "string" }, "maxItems": 32 },
                  "env": { "$ref": "#/definitions/env" }
                }
              },
              "database": { "$ref": "#/definitions/consumers/database" },
              "secrets": { "$ref": "#/definitions/consumers/secrets" }
            }
          }
        },
        "storage": {
          "description": "Forme v2alpha1 historique (objet = un volume 'data' sur main) ou liste E8 (multi-volumes).",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["profile", "mountPath", "size"],
              "properties": {
                "profile": { "enum": ["block-rwo"], "description": "Un PVC RWO (trait persistent-volume-claim). StorageClass : capabilities du cluster." },
                "mountPath": { "type": "string", "pattern": "^/[A-Za-z0-9._/-]+$" },
                "size": { "type": "string", "pattern": "^[1-9][0-9]{0,3}Gi$" }
              }
            },
            { "type": "array", "minItems": 1, "maxItems": 6, "items": { "$ref": "#/definitions/volume" } }
          ]
        },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["engine"],
          "properties": {
            "engine": { "const": "postgres" },
            "instance": { "enum": ["lab-pg", "pg-shared"], "default": "lab-pg", "description": "E1. Admis seulement si clusters/<cluster>/capabilities.yaml le liste (pg-shared : non admis aujourd'hui)." },
            "envVar": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$", "default": "DATABASE_URL" }
          }
        },
        "secrets": {
          "type": "array", "maxItems": 16, "uniqueItems": true,
          "description": "References seulement (ESO). Valeur jamais dans Git.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["env", "key"],
            "properties": {
              "env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
              "key": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$", "description": "Cle du store ; prefixe <NAME>_ verifie par la CI." },
              "property": { "type": "string" }
            }
          }
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "oidc": {
              "type": "object",
              "additionalProperties": false,
              "required": ["issuer", "clientId", "clientSecretKey"],
              "properties": {
                "provider": { "enum": ["thunderid", "authentik"], "default": "thunderid", "description": "E2. Admis seulement si liste dans capabilities.identityProviders du cluster." },
                "issuer": { "type": "string", "format": "uri", "pattern": "^https://" },
                "clientId": { "type": "string", "minLength": 1 },
                "clientSecretKey": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
                "allowedGroups": {
                  "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
                  "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}$" },
                  "description": "Groupes IdP autorises a se connecter (liaison cote IdP). Obligatoire avec authentik."
                },
                "adminGroup": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}$", "description": "Groupe administrateur ; doit appartenir a allowedGroups si celui-ci est defini." }
              },
              "if": { "properties": { "provider": { "const": "authentik" } }, "required": ["provider"] },
              "then": { "required": ["allowedGroups"] }
            }
          }
        },
        "exposure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "auth"],
          "properties": {
            "mode": { "enum": ["private", "public"], "default": "private", "description": "private = endpoint visibility internal. public = external, via Cloudflare Tunnel -> kgateway ClusterIP. Jamais de LoadBalancer OCI." },
            "host": { "type": "string", "pattern": "^[a-z0-9-]+\\.[a-z0-9.-]+$" },
            "auth": { "enum": ["none", "app-oidc", "app-password", "cloudflare-access"], "description": "app-password : authentification propre a l'app (ex. clients Stremio d'AIOStreams, incompatibles avec un login navigateur). none interdit si public." }
          },
          "if": { "properties": { "mode": { "const": "public" } } },
          "then": { "required": ["host"], "properties": { "auth": { "not": { "const": "none" } } } }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["egress"],
          "properties": {
            "egress": {
              "description": "E3. Alias historiques : none | public-internet (0.0.0.0/0 sauf RFC1918, 100.64/10, 169.254/16 ; TCP 80/443). Sinon liste d'autorisations : fqdn, fqdnPattern (Cilium seulement), cidr (public ; prive seulement si capabilities.privateEgressCIDRs), app (autre app native).",
              "oneOf": [
                { "enum": ["none", "public-internet"] },
                { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/definitions/egressRule" } }
              ]
            },
            "allowIdp": { "type": "boolean", "default": false, "description": "Egress vers le namespace de l'IdP du labo (ThunderID)." }
          }
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["class"],
          "description": "T-025, ADR-0008 (G8). Classe de la donnee de l'app. Obligatoire des qu'une base (database) ou un volume (storage) est declare (regle semantique, CI). Propagee en label platform.smadja.dev/data-class sur le namespace de cellule, le PVC et la base. irreplaceable : refuse par la CI tant qu'aucune restauration hors Oracle n'est prouvee (comme backup.class).",
          "properties": {
            "class": { "enum": ["ephemeral", "rebuildable", "useful", "irreplaceable"] }
          }
        },
        "backup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["class"],
          "properties": {
            "class": { "enum": ["none", "regenerable", "irreplaceable"], "description": "D-2026-11-11-05. irreplaceable refuse par la CI tant qu'une restauration hors Oracle n'est pas prouvee (D-2026-11-14-03)." },
            "mechanism": { "enum": ["none", "cnpg", "velero"], "default": "none", "description": "E9. Admis seulement si liste dans capabilities.backupMechanisms ; cnpg exige database, velero exige storage." },
            "rpo": { "type": "string", "pattern": "^[0-9]+(m|h|d)$" },
            "rto": { "type": "string", "pattern": "^[0-9]+(m|h|d)$" },
            "retention": { "type": "string", "pattern": "^[1-9][0-9]{0,2}d$" }
          },
          "allOf": [
            { "if": { "properties": { "class": { "const": "irreplaceable" } } }, "then": { "required": ["rpo", "rto", "retention"] } },
            { "if": { "properties": { "mechanism": { "enum": ["cnpg", "velero"] } }, "required": ["mechanism"] }, "then": { "required": ["retention"] } }
          ]
        },
        "securityExceptions": {
          "type": "array", "maxItems": 4,
          "description": "E12. Exceptions nominatives, motivees et datees. Expiree = refus. Duree maximale 90 jours (CI).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rule", "reason", "expires", "approver"],
            "properties": {
              "rule": { "enum": ["run-as-root", "writable-rootfs"] },
              "workload": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,10}[a-z0-9]$", "default": "main" },
              "reason": { "type": "string", "minLength": 20, "maxLength": 300 },
              "expires": { "type": "string", "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$" },
              "approver": { "type": "string", "pattern": "^(group|user):default/[a-z][a-z0-9-]*$" }
            }
          }
        },
        "observability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["metrics"],
          "properties": {
            "metrics": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled"],
              "properties": {
                "enabled": { "type": "boolean" },
                "path": { "type": "string", "pattern": "^/[A-Za-z0-9/_-]*$", "default": "/metrics" },
                "port": { "type": "integer", "minimum": 1024, "maximum": 65535 }
              }
            },
            "alerts": { "enum": ["default", "none"], "default": "default" }
          }
        },
        "update": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "strategy": { "enum": ["RollingUpdate", "Recreate"], "default": "RollingUpdate" },
            "automerge": { "enum": ["none", "digest", "patch", "minor"], "default": "digest" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "profile": { "const": "stateless" } } },
          "then": { "not": { "anyOf": [ { "required": ["database"] }, { "required": ["storage"] } ] } }
        },
        {
          "if": { "properties": { "profile": { "const": "stateful" } } },
          "then": { "anyOf": [ { "required": ["database"] }, { "required": ["storage"] } ] }
        },
        {
          "if": { "properties": { "source": { "required": ["image"] } } },
          "then": { "required": ["runtime"] },
          "else": { "not": { "anyOf": [ { "required": ["runtime"] }, { "required": ["database"] }, { "required": ["workloads"] }, { "required": ["jobs"] }, { "required": ["securityExceptions"] } ] } }
        },
        {
          "if": { "required": ["storage"] },
          "then": { "properties": { "update": { "required": ["strategy"], "properties": { "strategy": { "const": "Recreate" } } } }, "required": ["update"] }
        },
        {
          "if": {
            "required": ["identity"],
            "properties": { "identity": { "required": ["oidc"], "properties": { "oidc": { "not": { "properties": { "provider": { "const": "authentik" } }, "required": ["provider"] } } } } }
          },
          "then": { "properties": { "network": { "anyOf": [ { "properties": { "egress": { "const": "public-internet" } } }, { "properties": { "allowIdp": { "const": true } }, "required": ["allowIdp"] } ] } } }
        }
      ]
    }
  }
}
