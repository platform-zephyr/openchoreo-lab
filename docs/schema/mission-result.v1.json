{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mission-result.v1",
  "title": "Compte rendu d'une session d'agent (T-313)",
  "description": "Aucun prompt, aucune sortie d'outil, aucun secret. Les statuts suivent PASS / FAIL / NOT_TESTED / BLOCKED.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ticket_issue", "model_requested", "model_observed", "effort", "escalated_from", "status",
               "num_turns", "duration_ms", "total_cost_usd", "tokens", "ci_failures", "checks"],
  "properties": {
    "schema": {"const": "mission-result.v1"},
    "ticket_issue": {"type": "integer", "minimum": 1},
    "model_requested": {"enum": ["claude-haiku-5-5", "claude-sonnet-5-5", "claude-opus-5-5"]},
    "model_observed": {"type": "string"},
    "effort": {"enum": ["low", "medium", "high", "xhigh", "max"]},
    "escalated_from": {"type": ["string", "null"]},
    "status": {"enum": ["PASS", "FAIL", "NOT_TESTED", "BLOCKED"]},
    "failure": {"enum": ["model_mismatch", "no_branch"]},
    "branch": {"type": ["string", "null"]},
    "num_turns": {"type": "integer", "minimum": 0},
    "duration_ms": {"type": "integer", "minimum": 0},
    "total_cost_usd": {"type": "number", "minimum": 0},
    "permission_denials": {"type": "array", "items": {"type": "string"}},
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "cache_read_input_tokens", "cache_creation_input_tokens"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "cache_read_input_tokens": {"type": "integer", "minimum": 0},
        "cache_creation_input_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "ci_failures": {"type": "integer", "minimum": 0},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["static", "ci", "runtime"],
      "properties": {
        "static": {"enum": ["PASS", "FAIL", "NOT_TESTED", "BLOCKED"]},
        "ci": {"enum": ["PASS", "FAIL", "NOT_TESTED", "BLOCKED"]},
        "runtime": {"enum": ["PASS", "FAIL", "NOT_TESTED", "BLOCKED"]}
      }
    }
  }
}
