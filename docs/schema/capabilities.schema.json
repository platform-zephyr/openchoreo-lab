{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/platform-zephyr/openchoreo-lab/docs/schema/capabilities.schema.json",
  "title": "platform.smadja.dev/v1alpha1 ClusterCapabilities",
  "description": "Politique d'un cluster cible (clusters/<cluster>/capabilities.yaml). Lue par tools/appgen : tout ce qui n'est pas liste ici est refuse pour ce cluster. Modifier ce fichier = decision plateforme (PR revue), jamais une PR d'app.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "platform.smadja.dev/v1alpha1" },
    "kind": { "const": "ClusterCapabilities" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": { "name": { "enum": ["k3d", "oke"] } }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cilium", "databaseInstances", "identityProviders", "storageClasses", "backupMechanisms", "secretStore"],
      "properties": {
        "cilium": { "type": "boolean", "description": "true = CRD cilium.io/v2 presente ET CNP appliquees. Sans Cilium : egress FQDN refuse (voir APP-CONTRACT 1.1)." },
        "privateEgressCIDRs": {
          "type": "array", "uniqueItems": true, "maxItems": 16,
          "items": { "type": "string", "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}$" },
          "description": "CIDR prives (RFC1918, CGNAT) qu'une app peut viser nominativement. Jamais 169.254.0.0/16 (IMDS)."
        },
        "databaseInstances": {
          "type": "object", "minProperties": 1,
          "propertyNames": { "enum": ["lab-pg", "pg-shared"] },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["resourceType", "namespace", "cluster"],
            "properties": {
              "resourceType": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "namespace": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "cluster": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "backup": { "enum": ["none", "cnpg"], "default": "none" }
            }
          }
        },
        "identityProviders": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["thunderid", "authentik"] }
        },
        "storageClasses": {
          "type": "object", "minProperties": 1,
          "propertyNames": { "enum": ["block-rwo", "rwx-shared"] },
          "additionalProperties": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
          "description": "Profil de volume -> StorageClass. Profil absent = refuse sur ce cluster."
        },
        "backupMechanisms": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["none", "cnpg", "velero"] }
        },
        "secretStore": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "description": "ClusterSecretStore ESO (parcours Helm)." }
      }
    }
  }
}
