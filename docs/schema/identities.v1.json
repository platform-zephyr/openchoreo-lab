{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "identities.v1",
  "title": "Registre des identités et secrets (T-306)",
  "description": "Noms, rôles, dates, consommateurs et coffre. AUCUN champ de valeur : additionalProperties=false partout. Pas d'IP, d'hôte interne ni d'e-mail.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "identities"],
  "properties": {
    "version": {"const": 1},
    "identities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/identity"}
    }
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "date": {"type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "role", "scope", "owner", "created", "rotate_by", "dev", "vault", "consumers"],
      "properties": {
        "name": {"$ref": "#/$defs/slug"},
        "kind": {"enum": ["identite", "jeton", "cle", "secret", "kubeconfig", "acces"]},
        "role": {"type": "string", "minLength": 3, "maxLength": 120},
        "scope": {"type": "string", "minLength": 3, "maxLength": 160},
        "owner": {"enum": ["paul", "agent", "plateforme"]},
        "created": {"$ref": "#/$defs/date"},
        "created_is_estimate": {"type": "boolean"},
        "rotate_by": {"$ref": "#/$defs/date"},
        "last_rotated": {"$ref": "#/$defs/date"},
        "dev": {"type": "boolean"},
        "vault": {"enum": ["doppler", "openbao", "github", "authentik", "cloudflare", "etat-opentofu", "aucun"]},
        "consumers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/slug"}, "uniqueItems": true},
        "note": {"type": "string", "maxLength": 200}
      }
    }
  }
}
