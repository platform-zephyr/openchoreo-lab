# Versions épinglées de la Phase B (sourcé par tools/oke/*.sh). Relevé le 2026-11-17 par `helm pull`
# (digest OCI du chart) + sha256 du .tgz, et API de registre (digest d'index multi-arch, arm64 vérifié).
# Toute montée de version = PR qui change CE fichier et les values, puis tools/oke/install.sh --step N.
# shellcheck disable=SC2034  # variables consommées par les scripts qui sourcent ce fichier

# Gateway API CRD (standard channel) : manifest téléchargé puis vérifié par sha256 avant application.
GW_CRDS_VERSION="v1.5.1"
GW_CRDS_URL="https://github.com/kubernetes-sigs/gateway-api/releases/download/v1.5.1/standard-install.yaml"
GW_CRDS_SHA256="751002b3b91a87f7ae3bd2517c79a47a8d7ed6702901808a1cf9bd97d284f9b8"

# Cilium (étape 0, T-494) : même version que kube-ops #1620 (prouvée sur OKE le 2026-11-17) et le homelab.
